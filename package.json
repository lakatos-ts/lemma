{
  "name": "@lakatos/lemma",
  "version": "0.2.1",
  "description": "The Lemma annotation language and lakatos's TypeScript front end: discovery of annotated files, @ensures extraction, the formula parser, binder domains, the typecheck gate, the parser bridge to ESTree, thales's emitter, and the lemma bin that prints a checked-program document per file.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lemma": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "schemas",
    "spec/README.md",
    "spec/grammar.ebnf",
    "spec/semantics.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakatos-ts/lemma.git"
  },
  "homepage": "https://github.com/lakatos-ts/lemma#readme",
  "bugs": {
    "url": "https://github.com/lakatos-ts/lemma/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "fast-check": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "prettier": "3.9.9",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
